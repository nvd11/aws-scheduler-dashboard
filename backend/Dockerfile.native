# ==============================================================================
# Stage 1: Build Quarkus Native Executable using Mandrel JDK 21 (GraalVM AOT)
# ==============================================================================
FROM quay.io/quarkus/ubi-quarkus-mandrel-builder-image:jdk-21 AS builder
USER root
WORKDIR /build

# 1. Cache Maven wrapper & dependencies first
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B || true

# 2. Copy source and compile native executable
COPY src ./src
RUN ./mvnw -B package -Dnative -DskipTests

# ==============================================================================
# Stage 2: Minimal ARM64/Multi-Arch Runtime Image (debian:12-slim + CA certs + tzdata)
# ==============================================================================
FROM debian:12-slim
LABEL maintainer="Jason <jason1.pan@hsbc.com.hk>"
LABEL org.opencontainers.image.source="https://github.com/nvd11/aws-scheduler-dashboard"

WORKDIR /app

# Install root CA certificates (for AWS & GitHub HTTPS) and timezone data (Asia/Shanghai)
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

# Non-root user setup
RUN groupadd -r scheduler --gid 1000 && useradd -r -g scheduler --uid 1000 -d /app scheduler

# Copy native runner binary
COPY --from=builder --chown=scheduler:scheduler /build/target/*-runner /app/application
RUN chmod +x /app/application

USER 1000
EXPOSE 8080

ENV QUARKUS_HTTP_HOST=0.0.0.0
ENV QUARKUS_HTTP_PORT=8080

# Cap Native Heap at 48MB to strictly enforce <64MB container RSS on radxa-cubie-a7a
ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0", "-Xmx48m", "-Xms16m"]
