# ==============================================================================
# AWS EventBridge Scheduler Dashboard - Environment Configuration Template
# Copy this file to .env and populate with actual credentials for local dev.
# In K3s production, inject via Kubernetes Secret / ConfigMap.
# ==============================================================================

# --- 1. Server & Runtime Configuration ---
QUARKUS_HTTP_PORT=8080
QUARKUS_HTTP_CORS_ORIGINS=http://localhost:5173,https://gw.jppwl.asia,https://gw-tx.jppwl.asia
APP_ENV=local

# --- 2. AWS Credentials & EventBridge Configuration ---
# IAM User (e.g. moon-cli) with permissions:
#   - scheduler:ListSchedules, scheduler:GetSchedule, scheduler:UpdateSchedule
#   - events:ListRules, events:ListTargetsByRule, events:ListApiDestinations, events:PutEvents
#   - cloudwatch:GetMetricData
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=186004631963
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_SCHEDULER_GROUP=default
AWS_EVENT_BUS_NAME=default

# --- 3. GitHub API Configuration (For Execution History & Manual Dispatch) ---
# GitHub Personal Access Token (PAT) with `repo` and `workflow` scopes
GITHUB_TOKEN=<YOUR_GITHUB_PAT_TOKEN>
GITHUB_API_BASE_URL=https://api.github.com

# --- 4. Cache & Refresh Configuration ---
# In-memory TTL (seconds) for GitHub workflow run history & AWS topology discovery
TOPOLOGY_CACHE_TTL_SECONDS=60
RUN_HISTORY_CACHE_TTL_SECONDS=15
